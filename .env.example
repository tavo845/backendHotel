# ==========================================
# Configuracion del servidor
# ==========================================
NODE_ENV=development
PORT=4000

# ==========================================
# Base de datos PostgreSQL (Render)
# ==========================================
# Render te entrega una "External Database URL" con este formato:
# postgresql://usuario:password@host:5432/nombre_bd
DATABASE_URL=postgresql://usuario:password@host.render.com:5432/nombre_bd

# En Render la conexion externa requiere SSL. Deja en "true" para produccion.
# Para una base local sin SSL, ponlo en "false".
DB_SSL=true

# ==========================================
# Autenticacion (JWT)
# ==========================================
JWT_SECRET=cambia_este_secreto_por_uno_seguro
JWT_EXPIRES_IN=1d

# ==========================================
# Pagos (Stripe)
# ==========================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Moneda por defecto para los pagos
DEFAULT_CURRENCY=usd

# ==========================================
# CORS
# ==========================================
# Origenes permitidos separados por coma. Usa * para permitir todos.
CORS_ORIGIN=*
